.pd-root {
    flex-grow: 1;
    background-color: rgb(34, 34, 38);
    color: rgb(212, 212, 218);
    font-size: 11px;
}

.pd-empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(130, 130, 140);
    white-space: normal;
    padding: 16px;
}

.pd-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 28px;
    padding: 2px 4px;
    background-color: rgb(46, 46, 52);
    border-bottom-width: 1px;
    border-bottom-color: rgb(22, 22, 25);
}

.pd-bar--bottom {
    border-bottom-width: 0;
    border-top-width: 1px;
    border-top-color: rgb(22, 22, 25);
}

.pd-bar--wrap {
    flex-wrap: wrap;
}

.pd-title {
    -unity-font-style: bold;
    color: rgb(225, 225, 230);
    margin-left: 4px;
    margin-right: 6px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pd-dim {
    color: rgb(140, 140, 150);
}

.pd-spacer {
    flex-grow: 1;
}

.pd-sep {
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background-color: rgb(70, 70, 78);
    flex-shrink: 0;
}

.unity-button.pd-btn {
    width: 24px;
    height: 24px;
    min-width: 24px;
    margin: 1px;
    padding: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.unity-button.pd-btn:hover {
    background-color: rgb(66, 66, 76);
}

.unity-button.pd-btn:active {
    background-color: rgb(84, 84, 96);
}

.unity-button.pd-btn.pd-on {
    background-color: rgb(62, 104, 186);
}

.unity-button.pd-btn.pd-on:hover {
    background-color: rgb(78, 122, 206);
}

.unity-button.pd-btn.pd-danger:hover {
    background-color: rgb(150, 60, 60);
}

.unity-button.pd-btn.pd-clip-on {
    background-color: rgb(170, 70, 70);
}

.unity-button.pd-btn--small {
    width: 18px;
    height: 18px;
    min-width: 18px;
}

.unity-button.pd-btn--text {
    width: auto;
    padding: 0 8px;
    color: rgb(212, 212, 218);
    background-color: rgb(58, 58, 66);
    margin: 2px;
    height: 22px;
}

.unity-button.pd-btn--text:hover {
    background-color: rgb(72, 72, 82);
}

.unity-button.pd-btn--accent {
    background-color: rgb(62, 104, 186);
}

.unity-button.pd-btn--accent:hover {
    background-color: rgb(78, 122, 206);
}

.pd-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(214, 214, 220);
}

.pd-btn:disabled .pd-icon {
    -unity-background-image-tint-color: rgb(95, 95, 102);
}

.pd-on .pd-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.pd-icon--dim {
    -unity-background-image-tint-color: rgb(110, 110, 118);
}

.pd-scroll {
    flex-grow: 1;
}

.pd-section {
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(22, 22, 25);
}

.pd-section__header {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 6px;
    background-color: rgb(44, 44, 50);
}

.pd-section__header:hover {
    background-color: rgb(52, 52, 60);
}

.pd-section__title {
    -unity-font-style: bold;
    color: rgb(205, 205, 212);
    margin-left: 4px;
    flex-grow: 1;
}

.pd-section__body {
    padding: 6px 8px 8px 8px;
    background-color: rgb(36, 36, 41);
}

.pd-section--closed .pd-section__body {
    display: none;
}

.pd-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin: 1px 0;
}

.pd-row--nowrap {
    flex-wrap: nowrap;
}

.pd-group {
    flex-direction: row;
    align-items: center;
    padding: 1px;
    margin: 1px 6px 1px 0;
    border-radius: 4px;
    background-color: rgb(46, 46, 53);
}

.pd-label {
    color: rgb(150, 150, 160);
    margin-right: 4px;
    min-width: 54px;
}

.pd-sub {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(125, 125, 135);
    margin: 6px 0 2px 0;
}

.pd-hint {
    color: rgb(120, 120, 130);
    white-space: normal;
    font-size: 10px;
    margin-top: 4px;
}

.pd-grow {
    flex-grow: 1;
}

.pd-swatches {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0;
}

.pd-swatch {
    width: 16px;
    height: 16px;
    margin: 1px;
    border-width: 1px;
    border-color: rgb(20, 20, 22);
}

.pd-swatch:hover {
    border-color: rgb(200, 200, 205);
}

.pd-swatch--current {
    border-color: rgb(255, 255, 255);
    border-width: 2px;
}

.pd-color-big {
    width: 42px;
    height: 42px;
    border-width: 1px;
    border-color: rgb(18, 18, 20);
    border-radius: 3px;
    margin-right: 6px;
}

.pd-banner {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 4px 8px;
    background-color: rgb(90, 70, 30);
    color: rgb(240, 220, 180);
    flex-shrink: 0;
}

.pd-banner Label {
    white-space: normal;
    flex-shrink: 1;
    flex-grow: 1;
}

.pd-settings {
    padding: 4px 8px;
    background-color: rgb(40, 40, 46);
    border-bottom-width: 1px;
    border-bottom-color: rgb(22, 22, 25);
    flex-shrink: 0;
}

.pd-settings--hidden {
    display: none;
}

.pd-frame-label {
    -unity-font-style: bold;
    min-width: 46px;
    -unity-text-align: middle-center;
}

.pd-field-small {
    width: 64px;
    margin: 0 2px;
}

.pd-field-small .unity-base-field__label {
    min-width: 0;
    padding-right: 2px;
}

.pd-timeline {
    flex-grow: 1;
    flex-direction: row;
}

.pd-tl-left {
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgb(22, 22, 25);
}

.pd-tl-right {
    flex-grow: 1;
    flex-shrink: 1;
}

.pd-tl-header {
    flex-direction: row;
    height: 20px;
    flex-shrink: 0;
    background-color: rgb(42, 42, 48);
    border-bottom-width: 1px;
    border-bottom-color: rgb(22, 22, 25);
    align-items: center;
}

.pd-tl-row {
    flex-direction: row;
    height: 22px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 30, 34);
}

.pd-tl-row:hover {
    background-color: rgb(42, 42, 48);
}

.pd-tl-row--selected {
    background-color: rgb(50, 66, 96);
}

.pd-tl-row--selected:hover {
    background-color: rgb(56, 74, 106);
}

.pd-tl-row--clip {
    background-color: rgba(220, 70, 70, 0.22);
}

.pd-tl-row--clip.pd-tl-row--selected {
    background-color: rgba(220, 90, 110, 0.38);
}

.pd-tl-row--hidden .pd-tl-name {
    color: rgb(110, 110, 118);
}

.pd-tl-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 2px;
    padding-right: 4px;
}

.pd-tl-rename {
    flex-grow: 1;
    margin: 0 2px;
}

.pd-tl-badge {
    flex-direction: row;
    align-items: center;
    margin-right: 4px;
    color: rgb(150, 170, 210);
    font-size: 10px;
}

.pd-tl-clipmark {
    width: 14px;
    height: 16px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(240, 110, 110);
}

.pd-tl-cell {
    width: 20px;
    height: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: rgb(30, 30, 34);
}

.pd-tl-cell:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.pd-tl-cell--current {
    background-color: rgba(120, 160, 255, 0.16);
}

.pd-tl-head-cell {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 9px;
    color: rgb(150, 150, 160);
    border-right-width: 1px;
    border-right-color: rgb(30, 30, 34);
}

.pd-tl-head-cell:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(230, 230, 235);
}

.pd-tl-head-cell--current {
    background-color: rgb(62, 104, 186);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.pd-cel {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(225, 225, 230);
}

.pd-cel--empty {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(95, 95, 105);
}

.pd-cel--static {
    width: 14px;
    height: 4px;
    border-radius: 2px;
    background-color: rgb(120, 120, 132);
}

.pd-cel--none {
    display: none;
}

.pd-cel-link {
    position: absolute;
    left: -6px;
    width: 12px;
    height: 2px;
    top: 10px;
    background-color: rgb(225, 225, 230);
}

.pd-drop-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background-color: rgb(90, 150, 255);
    display: none;
}

.pd-slider {
    flex-grow: 1;
    margin: 0 4px;
}

.pd-slider .unity-base-field__label {
    min-width: 50px;
}

.pd-imgui {
    margin: 2px 0;
}
